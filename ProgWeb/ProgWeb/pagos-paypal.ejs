<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Pago de Cita</title>
    <link rel="icon" type="image/avif" href="/img/logo.avif">
    <!-- PAYPAL SDK -->
    <script src="https://www.paypal.com/sdk/js?client-id=AY9FVZLT7BP0qRIGRBStw0wQnfR1v0sR0ZO9qhTfUTJCQb3nf8Cbz7750piRN1-96ZN0Rz4oXPYLyzrn&currency=MXN"></script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light d-flex flex-column min-vh-100">

<!-- NAVBAR -->
<nav class="navbar navbar-dark bg-primary shadow-sm">
    <div class="container">
        <span class="navbar-brand fw-bold">Clínica San Rafael</span>
    </div>
</nav>

<!-- CONTENIDO -->
<div class="container d-flex justify-content-center align-items-center flex-grow-1">

    <div class="row w-100" style="max-width: 900px;">

        <!-- RESUMEN DE CITA -->
        <div class="col-md-6 mb-4">
            <div class="card shadow border-0 h-100">
                <div class="card-body">

                    <h4 class="fw-bold mb-3">🧾 Resumen de tu cita</h4>

                    <p><strong>Especialidad:</strong> <span id="esp"></span></p>
                    <p><strong>Fecha:</strong> <span id="fecha"></span></p>
                    <p><strong>Hora:</strong> <span id="hora"></span></p>

                    <hr>

                    <h5 class="text-primary fw-bold">
                        Total: $500 MXN
                    </h5>

                </div>
            </div>
        </div>

        <!-- PAGO -->
        <div class="col-md-6">
            <div class="card shadow border-0 h-100">
                <div class="card-body text-center d-flex flex-column justify-content-center">

                    <h4 class="fw-bold mb-3">💳 Pagar ahora</h4>
                    <p class="text-muted mb-4">
                        Puedes pagar con PayPal o tarjeta
                    </p>

                    <div id="paypal-button-container"></div>

                </div>
            </div>
        </div>

    </div>

</div>

<!-- FOOTER -->
<footer class="bg-dark text-white text-center py-3 mt-auto">
    <small>© 2026 Clínica San Rafael</small>
</footer>

<script>
const cita = JSON.parse(localStorage.getItem("cita_temp"));

if (!cita) {
    alert("No hay datos de cita");
    window.location.href = "/panel";
}

// MOSTRAR DATOS
document.getElementById("esp").textContent = cita.especialidad;

document.getElementById("fecha").textContent =
    new Date(cita.fecha + "T00:00:00").toLocaleDateString('es-MX', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });

document.getElementById("hora").textContent =
    new Date(`1970-01-01T${cita.hora}`).toLocaleTimeString([], {
        hour: '2-digit',
        minute: '2-digit'
    });

paypal.Buttons({

    style: {
        layout: 'vertical',
        color: 'blue',
        shape: 'pill',
        label: 'paypal'
    },

    createOrder: async () => {
        const res = await fetch("/crear-orden", {
            method: "POST"
        });

        const data = await res.json();
        return data.id;
    },

    onApprove: async (data) => {

    const cita = JSON.parse(localStorage.getItem("cita_temp"));

    // 1. guardar cita en backend
    await fetch("/citas", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify(cita)
    });

    // 2. limpiar storage
    localStorage.removeItem("cita_temp");

    // 3. redirigir
    window.location.href = "/pago-exitoso";
},

    onError: (err) => {
        console.error(err);
        alert("Error en el pago");
    }

}).render("#paypal-button-container");
</script>

</body>
</html>