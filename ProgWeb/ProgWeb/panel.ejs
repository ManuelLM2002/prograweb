<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal del Paciente - Agendar Cita</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/inicio">Clínica San Rafael</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/inicio">Inicio</a></li>
                <li class="nav-item"><a class="nav-link active" href="/panel">Agendar Cita</a></li>
                <li class="nav-item"><a class="nav-link" href="/mis-citas-view">Mis Citas</a></li>
                <li class="nav-item"><a class="nav-link" href="/galeria">Galería</a></li>
                <li class="nav-item">
                    <a class="nav-link text-danger" href="#" onclick="logout()">Cerrar Sesión</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container mt-4">
    <div class="row">

        <div class="col-lg-8">

            <!-- BIENVENIDA -->
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-body">
                    <h2 class="card-title">
                        Bienvenido, <span id="nombreUsuario"></span>
                    </h2>
                    <p class="text-muted">Aquí puedes gestionar tus citas médicas.</p>
                </div>
            </div>

            <!-- FORM -->
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h3 class="card-title mb-4">Agendar Nueva Cita</h3>

                    <form id="form-agendar">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Especialidad</label>
                            <select class="form-select form-select-lg" id="especialidad" required>
                                <option value="" disabled selected>Selecciona una opción...</option>
                                <option value="Medicina General">Medicina General</option>
                                <option value="Pediatría">Pediatría</option>
                                <option value="Cardiología">Cardiología</option>
                                <option value="Dermatología">Dermatología</option>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Fecha</label>
                                <input type="date" class="form-control form-control-lg" id="fecha" required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Hora</label>
                                <select class="form-select form-select-lg" id="hora" required disabled>
                                    <option value="" disabled selected>Primero elige una fecha...</option>
                                </select>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 shadow-sm mt-3">
                            Ir a pagar 💳
                        </button>

                    </form>

                </div>
            </div>
        </div>

        <!-- INFO -->
        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="card mb-3 shadow-sm border-0 bg-primary text-white">
                <div class="card-body text-center">
                    <h4 class="fw-bold">Información</h4>
                    <p class="mb-0">Recuerda llegar 15 minutos antes de tu cita para registro.</p>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h4 class="fw-bold text-primary">Contacto</h4>
                    <p class="mb-1"><strong>Tel:</strong> (555) 123-4567</p>
                    <p class="mb-0"><strong>Email:</strong> contacto@clinica.com</p>
                </div>
            </div>
        </div>

    </div>
</div>

<footer class="bg-dark text-white text-center py-4 mt-5">
    <p class="mb-0">© 2026 - Clínica San Rafael</p>
</footer>

<script>
    //  sesión
    const nombre = localStorage.getItem("user");
    const correo = localStorage.getItem("correo");

    if (!nombre || !correo) {
        alert("Debes iniciar sesión");
        window.location.href = "/login";
    }

    //  mostrar nombre
    document.getElementById("nombreUsuario").textContent = nombre;

    // logout
    function logout() {
        localStorage.clear();
        window.location.href = "/login";
    }

    // ==========================================
    // RESTRICCIÓN DE FECHAS Y HORARIOS
    // ==========================================
    
    const inputFecha = document.getElementById("fecha");
    const selectHora = document.getElementById("hora");

    // 1. Bloquear Hoy y Mañana
    const fechaMinima = new Date();
    fechaMinima.setDate(fechaMinima.getDate() + 2); // Sumamos 2 días
    const minFormat = fechaMinima.toISOString().split("T")[0]; // Formato YYYY-MM-DD
    inputFecha.setAttribute("min", minFormat);

    // 2. Generar horarios dinámicos al escoger un día
    inputFecha.addEventListener("change", async function() {
        selectHora.disabled = true;
        selectHora.innerHTML = '<option value="" disabled selected>⏳ Cargando disponibilidad...</option>';

        const fechaElegida = this.value; // Formato YYYY-MM-DD
        let horasOcupadas = [];

        // 🟢 PREGUNTAR A LA BASE DE DATOS QUÉ HORAS ESTÁN OCUPADAS
        try {
            const res = await fetch(`/api/horarios-ocupados?fecha=${fechaElegida}`);
            horasOcupadas = await res.json();
        } catch (error) {
            console.error("Error verificando disponibilidad");
        }

        const fechaSeleccionada = new Date(fechaElegida + "T00:00:00");
        const diaSemana = fechaSeleccionada.getDay(); // 0 = Domingo, 1 = Lunes... 6 = Sábado

        let horaInicio, horaFin;

        if (diaSemana === 0 || diaSemana === 6) {
            horaInicio = 10;
            horaFin = 17;
        } else {
            horaInicio = 9;
            horaFin = 22;
        }

        selectHora.innerHTML = '<option value="" disabled selected>Selecciona una hora...</option>';
        let slotsDisponibles = 0;

        // Crear los bloques de 30 minutos
        for (let h = horaInicio; h < horaFin; h++) {
            let horaString = h.toString().padStart(2, '0');
            
            // Evaluamos la hora en punto (:00)
            let horaPunto = `${horaString}:00`;
            if (horasOcupadas.includes(horaPunto)) {
                selectHora.innerHTML += `<option value="${horaPunto}" disabled>❌ ${horaPunto} - Ocupado</option>`;
            } else {
                selectHora.innerHTML += `<option value="${horaPunto}">✅ ${horaPunto}</option>`;
                slotsDisponibles++;
            }

            // Evaluamos la media hora (:30)
            let horaMedia = `${horaString}:30`;
            if (horasOcupadas.includes(horaMedia)) {
                selectHora.innerHTML += `<option value="${horaMedia}" disabled>❌ ${horaMedia} - Ocupado</option>`;
            } else {
                selectHora.innerHTML += `<option value="${horaMedia}">✅ ${horaMedia}</option>`;
                slotsDisponibles++;
            }
        }
        
        // Agregar la hora de cierre exacta
        let cierreString = `${horaFin.toString().padStart(2, '0')}:00`;
        if (horasOcupadas.includes(cierreString)) {
            selectHora.innerHTML += `<option value="${cierreString}" disabled>❌ ${cierreString} - Ocupado</option>`;
        } else {
            selectHora.innerHTML += `<option value="${cierreString}">✅ ${cierreString}</option>`;
            slotsDisponibles++;
        }

        // 🔴 SI NO HAY SLOTS DISPONIBLES, AVISAMOS QUE EL DÍA ESTÁ LLENO
        if (slotsDisponibles === 0) {
            selectHora.innerHTML = '<option value="" disabled selected>⚠️ Día completamente lleno</option>';
        }

        selectHora.disabled = false;
    });

    // NUEVO FLUJO CORRECTO
    document.getElementById("form-agendar").addEventListener("submit", function(e) {
        e.preventDefault();

        const especialidad = document.getElementById("especialidad").value;
        const fecha = document.getElementById("fecha").value;
        const hora = document.getElementById("hora").value;

        const citaTemp = {
            especialidad,
            fecha,
            hora,
            usuario: correo
        };

        // guardar temporal
        localStorage.setItem("cita_temp", JSON.stringify(citaTemp));

        // ir a pagos
        window.location.href = "/pagos-paypal";
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>