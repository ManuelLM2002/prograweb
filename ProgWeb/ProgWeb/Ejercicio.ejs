<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>
        function cambiar(color){
            document.body.style.background=color;
          }
    </script>
    <title>Cambiar color</title>
</head>
<body>
    <h2>Cambiar color de fondo</h2>
    <button id="verde" onclick="cambiar('green')">Verde</button>
    <button id="naranja" onclick="cambiar('#ffa500')">Naranja</button>
</body>
</html>