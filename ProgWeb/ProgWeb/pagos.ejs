<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Pagos - Clínica San Rafael</title>
    <link rel="icon" type="image/avif" href="/img/logo.avif">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">
    <div class="card p-4 shadow">
        <h3 class="text-center mb-4">Pago de Consulta</h3>

        <div class="alert alert-info text-center">
            Total a pagar: <strong>$500 MXN</strong>
        </div>

        <form id="form-pago">

            <!-- NOMBRE -->
            <input id="nombre" class="form-control mb-2" placeholder="Nombre en la tarjeta" required>
            <div class="text-danger small mb-2" id="error-nombre"></div>

            <!-- TARJETA -->
            <input id="tarjeta" class="form-control mb-2" placeholder="0000 0000 0000 0000" maxlength="19" required>
            <div class="text-danger small mb-2" id="error-tarjeta"></div>

            <!-- FECHA -->
            <input id="fecha" class="form-control mb-2" placeholder="MM/AA" maxlength="5" required>
            <div class="text-danger small mb-2" id="error-fecha"></div>

            <!-- CVV -->
            <input id="cvv" type="password" class="form-control mb-2" placeholder="CVV" maxlength="3" required>
            <div class="text-danger small mb-3" id="error-cvv"></div>

            <button class="btn btn-success w-100">Pagar</button>
        </form>
    </div>
</div>

<script>
const nombre = document.getElementById("nombre");
const tarjeta = document.getElementById("tarjeta");
const fecha = document.getElementById("fecha");
const cvv = document.getElementById("cvv");

// 🔥 VALIDACIONES EN TIEMPO REAL

// Nombre → solo letras
nombre.addEventListener("input", function() {
    this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúñÑ\s]/g, "");

    document.getElementById("error-nombre").textContent =
        this.value.length < 3 ? "Nombre inválido" : "";
});

// Tarjeta → solo números + formato
tarjeta.addEventListener("input", function() {
    this.value = this.value.replace(/\D/g, "");
    this.value = this.value.replace(/(.{4})/g, "$1 ").trim();

    document.getElementById("error-tarjeta").textContent =
        this.value.length < 19 ? "Tarjeta incompleta" : "";
});

// Fecha → formato MM/AA
fecha.addEventListener("input", function() {
    this.value = this.value.replace(/\D/g, "");
    
    if (this.value.length >= 3) {
        this.value = this.value.slice(0,2) + "/" + this.value.slice(2,4);
    }

    document.getElementById("error-fecha").textContent =
        this.value.length < 5 ? "Fecha inválida" : "";
});

// CVV → solo 3 números
cvv.addEventListener("input", function() {
    this.value = this.value.replace(/\D/g, "");

    document.getElementById("error-cvv").textContent =
        this.value.length !== 3 ? "CVV inválido" : "";
});


// 💳 PAGO
document.getElementById("form-pago").addEventListener("submit", async function(e){
    e.preventDefault();

    // validar todo antes
    if (
        nombre.value.length < 3 ||
        tarjeta.value.length < 19 ||
        fecha.value.length < 5 ||
        cvv.value.length !== 3
    ) {
        alert("Completa correctamente los datos ❌");
        return;
    }

    const citaTemp = JSON.parse(localStorage.getItem("cita_temp"));

    if (!citaTemp) {
        alert("No hay cita pendiente");
        return;
    }

    try {
        const res = await fetch("/citas", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                ...citaTemp,
                estado: "Confirmada"
            })
        });

        if (res.ok) {
            localStorage.removeItem("cita_temp");
            alert("Pago realizado correctamente 💳");
            window.location.href = "/citas";
        } else {
            alert("Error al procesar el pago");
        }

    } catch (error) {
        console.error(error);
        alert("Error de conexión");
    }
});
</script>

</body>
</html>